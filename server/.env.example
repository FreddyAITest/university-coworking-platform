# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Allowed users (comma-separated emails, empty = allow all Supabase-authenticated users)
ALLOWED_EMAILS=

# Server
PORT=3001

# Local filesystem storage path (relative to server/ or absolute)
STORAGE_PATH=./storage

# Claude API (for AI doc sorting + task extraction)
ANTHROPIC_API_KEY=your-api-key
